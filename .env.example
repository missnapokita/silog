# Add these as Vercel Project Environment Variables. Never put real values in frontend files.
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_STANDARD_REST_TOKEN
VOUCHER_SIGNING_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

PUBLIC_SITE_ORIGIN=https://silog-three.vercel.app
SHORT_LINK_URL=https://earn4link.in/IPuIw
ANDROID_APP_PACKAGE=com.bisayatoolkit.ph
MIN_GATE_SECONDS=8
MAX_VOUCHERS_PER_DEVICE_DAY=5

